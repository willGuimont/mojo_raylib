from raylib.types import Color


# Predefined Raylib Colors as functions for easy runtime use
def LIGHTGRAY() -> Color:
    return Color(200, 200, 200, 255)


def GRAY() -> Color:
    return Color(130, 130, 130, 255)


def DARKGRAY() -> Color:
    return Color(80, 80, 80, 255)


def YELLOW() -> Color:
    return Color(253, 249, 0, 255)


def GOLD() -> Color:
    return Color(255, 203, 0, 255)


def ORANGE() -> Color:
    return Color(255, 161, 0, 255)


def PINK() -> Color:
    return Color(255, 109, 194, 255)


def RED() -> Color:
    return Color(230, 41, 55, 255)


def MAROON() -> Color:
    return Color(190, 33, 55, 255)


def GREEN() -> Color:
    return Color(0, 228, 48, 255)


def LIME() -> Color:
    return Color(0, 158, 47, 255)


def DARKGREEN() -> Color:
    return Color(0, 117, 44, 255)


def SKYBLUE() -> Color:
    return Color(102, 191, 255, 255)


def BLUE() -> Color:
    return Color(0, 121, 241, 255)


def DARKBLUE() -> Color:
    return Color(0, 82, 172, 255)


def PURPLE() -> Color:
    return Color(200, 122, 255, 255)


def VIOLET() -> Color:
    return Color(135, 60, 190, 255)


def DARKPURPLE() -> Color:
    return Color(112, 31, 126, 255)


def BEIGE() -> Color:
    return Color(211, 176, 131, 255)


def BROWN() -> Color:
    return Color(127, 106, 79, 255)


def DARKBROWN() -> Color:
    return Color(76, 63, 47, 255)


def WHITE() -> Color:
    return Color(255, 255, 255, 255)


def BLACK() -> Color:
    return Color(0, 0, 0, 255)


def BLANK() -> Color:
    return Color(0, 0, 0, 0)


def MAGENTA() -> Color:
    return Color(255, 0, 255, 255)


def RAYWHITE() -> Color:
    return Color(245, 245, 245, 255)
