comptime FLAG_BORDERLESS_WINDOWED_MODE: UInt32 = 0x00008000
comptime FLAG_MSAA_4X_HINT: UInt32 = 0x00000020
comptime FLAG_INTERLACED_HINT: UInt32 = 0x00010000

