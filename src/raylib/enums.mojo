# Config Flags
comptime FLAG_VSYNC_HINT: UInt32 = 0x00000040
comptime FLAG_FULLSCREEN_MODE: UInt32 = 0x00000002
comptime FLAG_WINDOW_RESIZABLE: UInt32 = 0x00000004
comptime FLAG_WINDOW_UNDECORATED: UInt32 = 0x00000008
